# TheRock 10.2.0 release manifest: everything therock-nixos fetches for this version.
#
# Generated by `nix run .#update -- 10.2.0`; AMD's wheel index publishes no hashes.
# A GPU target missing from `devices` cannot be built until it is hashed here.
{
  version = "10.2.0";
  index = "https://stable.repo.amd.com/rocm/whl-next";

  # Arch-neutral wheels, one store path each, shared by every GPU target.
  wheels = {
    rocm-sdk-core = "sha256-AkWmlMdVGjF6eGZvL8UYyHtA2ftk4tdvHw76Fl5XlCg=";
    rocm-sdk-devel = "sha256-GBosDb99mbvf/Gt1VAwWWTHTJGqgZX0JaZyfOmHDBMc=";
    rocm-sdk-libraries = "sha256-i3V2j0PcNy4bNt0vv+D4Kt0dBngKCNCa3fRFtCNmRB4=";
  };

  # Per-GPU kernel wheels (rocm-sdk-device-<gfx>).
  devices = {
    gfx1100 = "sha256-Tiw5TORsWUuoWWi2Fb/fy1uUXX3rRd7UcOz7RlyVkbg=";
    gfx1151 = "sha256-rm8CK/WfVWWzqIRA3Vp8Z67XPTP6QqyJA268243xQog=";
  };

  # Kernel images torch's AOTriton needs but AMD's torch wheels don't ship
  # (torch/lib/aotriton.images). Keyed by AOTriton's family name.
  aotriton = {
    version = "0.14.1b";
    images = {
      gfx110x = "sha256-/Hxuq+K81cUjsYinTbS/WUzqDZfX0h8/Lq0skTVLoZo=";
      gfx115x = "sha256-rwBXp+KlfkX6ANB76szw/In1iqRVRYqdXtXAHJ2Xtdw=";
    };
  };
}
