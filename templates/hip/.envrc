# therock-nixos, for Nix users (does nothing without Nix): the shell for this
# machine's GPU set (THEROCK_GFX > /etc/therock/targets > the GPUs in /sys).
# `direnv reload` after changing THEROCK_GFX.
if has nix; then
  watch_file /etc/therock/targets
  if set=$(nix run --quiet .#set); then
    use flake ".#shells.$set"
  fi
fi
